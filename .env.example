# ─────────────────────────────────────────────────────────────
# Esposito–Dossantos Foundation — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://esposito-dossantos.org

# ── Payments / Donations ─────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── CRM / Lead capture ───────────────────────────────────────
# Choose your provider (HubSpot / Salesforce / Airtable / Supabase)
HUBSPOT_PRIVATE_APP_TOKEN=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=

# ── Email / Newsletter ───────────────────────────────────────
RESEND_API_KEY=
NEWSLETTER_AUDIENCE_ID=

# ── Bot protection ───────────────────────────────────────────
# Cloudflare Turnstile (or reCAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
