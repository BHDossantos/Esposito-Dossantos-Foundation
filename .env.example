# ─────────────────────────────────────────────────────────────
# Harmonia Foundation — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://harmonia-foundation.org

# ── Social profiles ──────────────────────────────────────────
# Optional. When set, each URL renders as a footer icon link and is
# added to the Organization schema `sameAs`. Leave blank to hide.
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_X_URL=

# ── Payments / Donations ─────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── CRM / Lead capture ───────────────────────────────────────
# Choose your provider (HubSpot / Salesforce / Airtable / Supabase)
HUBSPOT_PRIVATE_APP_TOKEN=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=

# ── Submissions store + Admin dashboard ──────────────────────
# Supabase REST (persists form submissions; powers /admin)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Password for the /admin dashboard sign-in
ADMIN_PASSWORD=

# ── Email / Newsletter ───────────────────────────────────────
RESEND_API_KEY=
NEWSLETTER_AUDIENCE_ID=
# From address for transactional email (donor portal magic links)
EMAIL_FROM="Harmonia Foundation <noreply@harmonia-foundation.org>"

# ── Donor portal ─────────────────────────────────────────────
# Secret used to sign donor magic-link / session tokens.
# Falls back to ADMIN_PASSWORD if unset. Uses Stripe for giving history.
PORTAL_SECRET=

# ── Automated email sequences ────────────────────────────────
# Secret authorizing the cron endpoint (/api/cron/email-sequences).
# Vercel Cron (see vercel.json) is authorized automatically.
CRON_SECRET=

# ── AI outreach recommendations (admin) ──────────────────────
# Anthropic API key powering AI recommendations in the admin dashboard.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=

# ── Bot protection ───────────────────────────────────────────
# Cloudflare Turnstile (or reCAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
