{
  "name": "esposito-dossantos-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Premium global nonprofit platform for the Esposito–Dossantos Foundation",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cap:add:ios": "npx --yes @capacitor/cli@8.6.0 add ios",
    "cap:add:android": "npx --yes @capacitor/cli@8.6.0 add android",
    "cap:assets": "npx --yes @capacitor/assets@3.0.5 generate --iconBackgroundColor '#0B1F3A' --iconBackgroundColorDark '#0B1F3A' --splashBackgroundColor '#0B1F3A' --splashBackgroundColorDark '#071528'",
    "cap:sync": "npx --yes @capacitor/cli@8.6.0 sync",
    "cap:open:ios": "npx --yes @capacitor/cli@8.6.0 open ios",
    "cap:open:android": "npx --yes @capacitor/cli@8.6.0 open android",
    "gen:app-icons": "node scripts/gen-app-icons.mjs",
    "test:mobile": "vitest run tests/mobile.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "next": "16.4.6",
    "next-intl": "4.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^17.5.0",
    "three": "^0.169.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
